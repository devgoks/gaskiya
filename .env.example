# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=sk-...
# Model used at runtime and for content generation. deepseek-flash is the current DeepSeek Flash model.
DEEPSEEK_MODEL=deepseek-flash
# OpenAI-compatible endpoint. Leave as is unless you proxy it.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Salt for hashing phone numbers. Rotate to unlink old reports from users.
MSISDN_SALT=change-me-to-a-long-random-string
# Optional: protect the moderator dashboard. Leave empty for open access in local dev.
DASHBOARD_TOKEN=
# Optional: require this exact Authorization header value on Qrios callbacks.
QRIOS_AUTH_SECRET=
# SQLite path. On Fly this points to the mounted volume.
DB_PATH=./data/gaskiya.db
PORT=8080
